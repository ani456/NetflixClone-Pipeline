# Local .terraform directories
**/.terraform/*

# .tfstate files — contain sensitive data, should never be committed
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (used only for local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files for providers (see note below on this one)
# .terraform.lock.hcl

# Ignore plan output files
*.tfplan
*tfplan*

# Ignore any .env files
.env
.env.*

# Mac/OS + editor noise
.DS_Store
.idea/
.vscode/
*.swp